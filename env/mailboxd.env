# Log level: trace, debug, info, warn, error
MAILBOXD_LOG_LEVEL=info

# HTTP server port
MAILBOXD_HTTP_PORT=15630

# Public URL for this mailboxd instance
MAILBOXD_PUBLIC_URL=http://localhost:15630

# Enable ANSI-colored logs (for terminal output)
MAILBOXD_ANSI_LOGS=false

# Enable JSON-formatted logs (for machine parsing)
MAILBOXD_JSON_LOGS=false

# Persist logs to files
MAILBOXD_LOG_TO_FILE=false

# Max number of server log files to retain
MAILBOXD_MAX_SERVER_LOG_FILES=5

# Encryption password for stored secrets (change this in production!)
MAILBOXD_ENCRYPT_PASSWORD=change-this-default-password-now

# Root directory for persistent storage (adjust to your environment)
MAILBOXD_ROOT_DIR=/data/mailboxd-data

# Enable API access token validation
MAILBOXD_ENABLE_ACCESS_TOKEN=false

# IP address to bind the HTTP servers to (default: 0.0.0.0)
MAILBOXD_BIND_IP=

# Comma-separated list of allowed CORS origins (e.g. https://app.example.com)
MAILBOXD_CORS_ORIGINS=

# Cache duration (in seconds) for CORS preflight responses
MAILBOXD_CORS_MAX_AGE=86400

# Enable HTTPS for REST API server
MAILBOXD_ENABLE_REST_HTTPS=false

# Enable HTTP response compression (gzip or brotli)
MAILBOXD_HTTP_COMPRESSION_ENABLED=true
