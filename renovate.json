{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "matchDepNames": ["reqwest"],
      "allowedVersions": "<0.13.0"
    },
    {
      "matchManagers": ["cargo"],
      "matchDepNames": ["native_model"],
      "allowedVersions": "<0.5.0"
    },
    {
      "matchManagers": ["npm"],
      "matchDepNames": ["typescript"],
      "allowedVersions": "<6.1.0",
      "description": "typescript-eslint 8.x supports TypeScript <6.1.0; TS 7 crashes eslint."
    }
  ]
}
