[Unit]
Description=mailboxd — self-hosted email archiving server
After=network.target
Wants=network.target

[Service]
Type=simple
User=mailboxd
Group=mailboxd
WorkingDirectory=/opt/mailboxd
ExecStart=/opt/mailboxd/mailboxd-server
Restart=always
RestartSec=5s
EnvironmentFile=/etc/mailboxd.conf

StandardOutput=null
StandardError=null
LogsDirectory=mailboxd
LogsDirectoryMode=0755

LimitNOFILE=65536
LimitCORE=0

PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateDevices=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
